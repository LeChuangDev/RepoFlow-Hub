# =============================================================================
# RepoFlow Hub · 环境变量示例
# 用法：复制为 .env 后填入自己的值；真实 .env 必须加入 .gitignore，禁止提交。
# 本文件只含占位值，不含任何真实凭据，可随开源仓库分发。
# =============================================================================

# ---- OAuth 应用凭据（BYOA：每个使用者自己注册第三方应用）------------------
# Client ID 可以公开；Client Secret 绝不写入开源分发的文件。
# GitHub 推荐 GitHub App + 带 PKCE 的授权码流程（公共客户端不需要 secret）。
REPOFLOW_GITHUB_CLIENT_ID=your_client_id_here
REPOFLOW_GITHUB_CLIENT_SECRET=

# Gitee OAuth2 授权码流程必须携带 client_secret（放在请求 Body）。
# 开源版本不内置共享密钥：使用者填入自己应用的凭据，仅从环境变量或系统密钥链读取。
REPOFLOW_GITEE_CLIENT_ID=your_client_id_here
REPOFLOW_GITEE_CLIENT_SECRET=

# ---- OAuth 回调（loopback 地址，端口由运行时分配）-------------------------
# 使用系统浏览器 + 本机临时端口，不嵌入 WebView；回调后立即关闭监听。
REPOFLOW_OAUTH_REDIRECT_URI=http://127.0.0.1:47821/callback

# ---- 请求范围（最小权限）---------------------------------------------------
REPOFLOW_GITHUB_SCOPES=repo read:org
REPOFLOW_GITEE_SCOPES=user_info projects pull_requests issues

# ---- 凭据存储 -------------------------------------------------------------
# keychain = 系统密钥链（Windows 凭据管理器 / macOS 钥匙串 / libsecret），推荐。
# env 仅供自动化测试使用，令牌不落盘明文、不进版本控制、不写进远程 URL。
REPOFLOW_CREDENTIAL_STORE=keychain
REPOFLOW_REFRESH_SKEW_SECONDS=300
REPOFLOW_ON_INVALID_GRANT=prompt-reauth

# ---- 可选：自建 GitLab / Gitea 主机 ---------------------------------------
# REPOFLOW_CUSTOM_HOST=https://git.example.com

# ---- 本地工作区（不要写死个人路径）---------------------------------------
REPOFLOW_WORKSPACE=
